# Xcode project — keep the project itself, drop only per-user state
Firnlight.xcodeproj/project.xcworkspace/xcuserdata/
Firnlight.xcodeproj/xcuserdata/
Firnlight.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
Firnlight.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# ---- SourceKit-LSP (xcode-build-server) ----
# Machine-specific build/index paths; regenerate with `xcode-build-server config`.
buildServer.json
.bsp/
.compile

# ---- Swift Package Manager ----
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/xcode/xcuserdata/
Package.resolved

# ---- Python (SwiftLens MCP venv) ----
.venv/
venv/
__pycache__/
*.py[cod]
.python-version

# ---- Claude Code (keep shared config, drop local/secret) ----
.claude/settings.local.json
.claude/**/*.local.json

# ---- Claude Code skills obtained, not vendored (FR-10.5) ----
# Regenerated from the local Xcode toolchain by
# .claude/hooks/apple-skills-export.sh — see .claude/skills/README.md.
.claude/skills/swiftui-specialist/
.claude/skills/swiftui-whats-new-27/
.claude/skills/building-document-based-swiftui-applications/

# ---- World reference data (FR-10.5's exception; obtained, not vendored) ----
# scripts/fetch-place-data.sh builds these from Natural Earth's public-domain
# map data; the repository carries only the means to obtain them, never the
# data itself. See that script's header and PlaceGazetteer.swift.
Firnlight/PlaceData/

