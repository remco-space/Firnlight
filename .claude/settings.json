{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skills-submodule-update.sh",
            "timeout": 15,
            "statusMessage": "Refreshing framework skills from upstream"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/apple-skills-export.sh",
            "timeout": 30,
            "statusMessage": "Exporting Apple skills from Xcode"
          }
        ]
      }
    ]
  }
}
